---
// Shared listing body for /inventory and /inventory/type/*: type links (work without JS), static unit cards,
// and the filter script that only drives which cards show and in what order (fast first paint on phones).
import InventoryFilter from './InventoryFilter.astro';
import UnitCard from '../islands/UnitCard';
import { cardData, groupOf, TYPE_GROUPS, type Unit } from '../../lib/inventory';
import { ESTIMATE_FOOTNOTE } from '../../lib/price';
import { REVIEW } from '../../lib/site';

interface Props { units: Unit[]; allUnits: Unit[]; currentGroup?: string }
const { units, allUnits, currentGroup } = Astro.props;
const cards = await Promise.all(units.map(cardData));
const filterUnits = units.map((u, i) => ({
  slug: u.slug,
  price: cards[i].price,
  sleeps: u.sleeps,
  make: u.make,
  year: u.year,
  lengthFt: u.lengthFt,
  keywords: [u.year, u.make, u.series, u.model, groupOf(u).label, u.type.replace('-', ' '), u.bunkhouse ? 'bunkhouse bunk bunks' : '',
    ...u.features, u.description].filter(Boolean).join(' ').toLowerCase(),
}));
const groups = TYPE_GROUPS.map((g) => ({ ...g, count: allUnits.filter((u) => groupOf(u).slug === g.slug).length })).filter((g) => g.count > 0);
---
<nav aria-label="Unit types" class="mb-6">
  <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
    <li>
      <a href="/inventory" aria-current={!currentGroup ? 'page' : undefined}
        class:list={['inline-flex min-h-11 items-center rounded border px-4 font-semibold no-underline',
          !currentGroup ? 'border-ink bg-ink text-white hover:text-white' : 'border-bark/40 bg-white text-ink hover:border-red']}>
        All units ({allUnits.length})
      </a>
    </li>
    {groups.map((g) => (
      <li>
        <a href={`/inventory/type/${g.slug}`} aria-current={currentGroup === g.slug ? 'page' : undefined}
          class:list={['inline-flex min-h-11 items-center rounded border px-4 font-semibold no-underline',
            currentGroup === g.slug ? 'border-ink bg-ink text-white hover:text-white' : 'border-bark/40 bg-white text-ink hover:border-red']}>
          {g.label} ({g.count})
        </a>
      </li>
    ))}
  </ul>
</nav>

<div class="grid gap-8 lg:grid-cols-12">
  <div class="needs-js lg:col-span-3">
    <InventoryFilter units={filterUnits} gridId="unit-grid" emptyId="unit-empty" countId="unit-count" />
  </div>
  <div class="lg:col-span-9 no-js:lg:col-span-12">
    <p id="unit-count" class="m-0 mb-4 font-semibold" aria-live="polite">Showing {units.length} of {units.length}</p>
    <ul id="unit-grid" class="m-0 grid list-none gap-6 p-0 sm:grid-cols-2 xl:grid-cols-3" aria-describedby="estimate-note">
      {cards.map((c, i) => (
        <li data-slug={c.slug} class="flex"><UnitCard unit={c} review={REVIEW} headingLevel={2} priority={i === 0} /></li>
      ))}
    </ul>
    <div id="unit-empty" hidden class="rounded border border-rule bg-paper p-6">
      <p class="m-0 text-lead font-semibold">Nothing on the lot matches that right now.</p>
      <p class="mt-2">Try fewer filters, or call us and tell us what you're after. Trade-ins and consignments come in all the time.</p>
      <button type="button" class="btn btn-secondary mt-3">Show all {units.length} units</button>
    </div>
  </div>
</div>

<div class="mt-8 border-t border-rule pt-4 text-[0.9375rem] text-bark-60">
  <p id="estimate-note" class="m-0">
    Prices include the PDI package and admin fee. HST and the government plate fee are extra.
    * {ESTIMATE_FOOTNOTE()}
  </p>
  <p class="m-0 mt-2">Units can sell quickly. Call to make sure the one you want is still here before you drive out.</p>
</div>
