---
// Reviews (plan D10): the four real testimonials with their period, no rating badge, and a direct line
// for anyone who had a problem.
import Base from '../layouts/Base.astro';
import PageIntro from '../components/astro/PageIntro.astro';
import Confirm from '../components/astro/Confirm.astro';
import dealership from '../data/dealership.json';
import testimonials from '../data/testimonials.json';
import { telHref } from '../lib/format';
import { breadcrumbJsonLd } from '../lib/seo';

const d = dealership;
const googleReview = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`RV Farm ${d.address.street} ${d.address.city}`)}`;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About us', path: '/about' }, { name: 'Reviews', path: '/reviews' }];
---
<Base title="Reviews" current="/about" jsonLd={[breadcrumbJsonLd(crumbs)]}
  description="What RV Farm customers have said, and how to reach us if something went wrong.">
  <PageIntro crumbs={crumbs} title="What customers said"
    lead={`These are Google reviews customers left between ${testimonials.period}, quoted word for word.`} />

  <section aria-label="Reviews" class="wrap py-10">
    <ul class="m-0 grid list-none gap-6 p-0 md:grid-cols-2">
      {testimonials.items.map((t) => (
        <li class="rounded border border-rule bg-paper p-6">
          <blockquote class="m-0"><p class="m-0 text-lead">“{t.quote}”</p></blockquote>
          <p class="m-0 mt-4 font-semibold">{t.name}{'place' in t && t.place ? `, ${t.place}` : ''}</p>
          <p class="m-0 text-[0.9375rem] text-bark-60">Google review, {testimonials.period}</p>
        </li>
      ))}
    </ul>
    <Confirm note={testimonials.confirm} />
  </section>

  <section aria-label="Leave a review or tell us about a problem" class="border-t border-rule bg-white">
    <div class="wrap grid gap-6 py-12 md:grid-cols-2">
      <div class="rounded border border-rule bg-paper p-6">
        <h2 class="m-0 text-[1.75rem]">Bought from us?</h2>
        <p class="mt-2">Tell other buyers how it went. Find us on Google Maps and choose “Write a review”.</p>
        <a href={googleReview} target="_blank" rel="noopener" class="btn btn-secondary mt-3">Find us on Google Maps<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
      <div class="rounded border-2 border-red bg-white p-6">
        <h2 class="m-0 text-[1.75rem]">Had a problem?</h2>
        <p class="mt-2">Call us directly and we’ll work through it with you.</p>
        <a href={telHref(d.phones.main)} class="btn btn-primary mt-3 tabular">Call {d.phones.main}</a>
      </div>
    </div>
  </section>
</Base>
