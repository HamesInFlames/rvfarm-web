---
// Reviews (plan D10): the four real testimonials with their period, no rating badge, an invitation to
// review us on Google, and a direct line for anyone who had a problem. Never show the Google rating or
// count, never quote other Google reviews here (James picks and pastes quotes himself with Rae's OK),
// never offer an incentive, and invite every customer, not only happy ones (Google bans review gating).
import Base from '../layouts/Base.astro';
import PageIntro from '../components/astro/PageIntro.astro';
import Confirm from '../components/astro/Confirm.astro';
import dealership from '../data/dealership.json';
import testimonials from '../data/testimonials.json';
import { telHref } from '../lib/format';
import { breadcrumbJsonLd } from '../lib/seo';
import { REVIEW } from '../lib/site';

const d = dealership;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About us', path: '/about' }, { name: 'Reviews', path: '/reviews' }];
// Quotes appear in production only once reuse permission is confirmed (testimonials.json).
const showQuotes = testimonials.confirmed || REVIEW;
---
<Base title="Reviews" current="/about" jsonLd={[breadcrumbJsonLd(crumbs)]}
  description="What RV Farm customers have said, and how to reach us if something went wrong.">
  <PageIntro crumbs={crumbs} title={showQuotes ? 'What customers said' : 'Reviews'}
    lead={showQuotes
      ? `These are Google reviews customers left between ${testimonials.period}, quoted word for word.`
      : 'Read what customers say about us on Google, and tell other buyers how it went.'} />

  {showQuotes && <section aria-label="Reviews" class="wrap py-10">
    <ul class="m-0 grid list-none gap-6 p-0 md:grid-cols-2">
      {testimonials.items.map((t) => (
        <li class="rounded border border-rule bg-paper p-6">
          <blockquote class="m-0"><p class="m-0 text-lead">“{t.quote}”</p></blockquote>
          <p class="m-0 mt-4 font-semibold">{t.name}{'place' in t && t.place ? `, ${t.place}` : ''}</p>
          <p class="m-0 text-[0.9375rem] text-bark-60">Google review, {testimonials.period}</p>
        </li>
      ))}
    </ul>
    {!testimonials.confirmed && <Confirm note={testimonials.confirm} />}
  </section>}

  <section aria-label="Leave a review or tell us about a problem" class="border-t border-rule bg-white">
    <div class="wrap grid gap-6 py-12 md:grid-cols-2">
      <div class="rounded border border-rule bg-paper p-6">
        <h2 class="m-0 text-[1.75rem]">Bought from us? Leave us a Google review</h2>
        <p class="mt-2">Whether you bought, sold, consigned or just visited, tell other buyers how it went. Every review helps us do better.</p>
        <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
          <a href={d.google.reviewUrl} target="_blank" rel="noopener" class="btn btn-primary">Write a Google review<span class="sr-only"> (opens in a new tab)</span></a>
          <a href={d.google.listingUrl} target="_blank" rel="noopener" class="tap">Read our reviews on Google<span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </div>
      <div class="rounded border-2 border-red bg-white p-6">
        <h2 class="m-0 text-[1.75rem]">Had a problem?</h2>
        <p class="mt-2">Call us directly and we’ll work through it with you.</p>
        <a href={telHref(d.phones.main)} class="btn btn-primary mt-3 tabular">Call {d.phones.main}</a>
      </div>
    </div>
  </section>
</Base>
