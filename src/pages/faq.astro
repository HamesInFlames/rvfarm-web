---
// FAQ. Answers point to the page that holds the detail; anything still open with the client is flagged.
import Base from '../layouts/Base.astro';
import PageIntro from '../components/astro/PageIntro.astro';
import Confirm from '../components/astro/Confirm.astro';
import dealership from '../data/dealership.json';
import fees from '../data/fees.json';
import { formatCad, formatCadCents, telHref } from '../lib/format';
import { advertisedPrice } from '../lib/price';
import { breadcrumbJsonLd } from '../lib/seo';

const d = dealership;
const extra = advertisedPrice(0);
const faqs: { q: string; a: string; link?: { href: string; text: string }; confirm?: string }[] = [
  { q: 'What’s included in the price I see?', a: `The unit plus our PDI package (pre-delivery inspection, starter kit and demo) and the admin and licensing fee, ${formatCad(extra)} together. Admin and licensing covers the MTO and ServiceOntario fees, plates included. HST is added at sale. Nothing else is required.`, link: { href: '/pricing', text: 'How our prices work' }, confirm: 'Admin fee: Rae $499 (Oct 8) vs Paul $599 (Oct 5); Paul to pick' },
  { q: 'Can I buy a unit as-is?', a: 'Yes, any unit. Without the PDI package, the inspection, the demo and any work the unit needs are your responsibility. If you want work done in our shop, we’ll quote it first.', link: { href: '/pricing#as-is', text: 'Buying as-is' }, confirm: 'Lawyer: how prices are shown when a unit can be bought as-is (item 7.8)' },
  { q: 'Can I hold a unit with a deposit?', a: 'Yes. Call us first. Our written deposit terms are being finalized, and we’ll go over them with you before you pay anything, including whether and when the deposit is refundable.', confirm: 'Paul’s deposit terms (lawyer reviewing)' },
  { q: 'How long does consignment take to pay out?', a: 'You’re paid after your unit sells, minus our 20% commission and any agreed fees. It can take up to 90 days.', link: { href: '/sell-or-consign#consign', text: 'How consignment works' }, confirm: 'Payout timeline: Rae said “90 days after the agreement is signed” (Oct 8); unclear, lawyer item' },
  { q: 'Do you deliver?', a: `Yes, at ${formatCadCents(fees.optional.delivery.ratePerKmCad)} per km plus HST, one way from the pick-up location to where it’s going, for units up to ${fees.optional.delivery.maxWidthFt} ft wide and ${fees.optional.delivery.maxLengthFt} ft long. Bigger units, like park models and mobile homes, we quote. Or pick it up here at no charge.`, link: { href: '/delivery', text: 'Delivery details' } },
  { q: 'Do you offer financing?', a: 'Yes. We work with several lenders. Once your deal looks like it will go ahead, one of our finance managers contacts you and goes through the application with you. Use our calculator to work out a payment first. We never ask for credit details on this website.', link: { href: '/financing', text: 'Financing and calculator' } },
  { q: 'Can I see a unit before I buy?', a: 'Yes. Call to book a time so the one you want is ready to look at. Units sell, so it’s worth checking it’s still here before you drive out.' },
  { q: 'Do you sell new units or motorhomes?', a: 'Right now we sell used trailers, park models and mobile homes only.', confirm: 'Used-only for now' },
  { q: 'Who services the trailer after I buy it?', a: `${d.sibling.name}, our sister business at the same address, does service, parts, warranty and insurance repairs. Their number is ${d.sibling.phone}.` },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About us', path: '/about' }, { name: 'Questions', path: '/faq' }];
---
<Base title="Questions" current="/about" jsonLd={[breadcrumbJsonLd(crumbs), faqJsonLd]}
  description="Answers about RV Farm prices, deposits, consignment, delivery, financing and viewings.">
  <PageIntro crumbs={crumbs} title="Questions people ask us"
    lead={`Don’t see yours? Call ${d.phones.main}.`} />
  <section aria-label="Questions and answers" class="wrap py-10">
    <div class="grid max-w-[52rem] gap-3">
      {faqs.map((f) => (
        <details class="group rounded border border-rule bg-paper">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 font-semibold text-ink [&::-webkit-details-marker]:hidden">
            <span>{f.q}</span><span aria-hidden="true" class="text-red transition-transform duration-200 group-open:rotate-45">+</span>
          </summary>
          <div class="px-5 pb-5">
            <p class="m-0">{f.a}{f.confirm && <Confirm note={f.confirm} />}</p>
            {f.link && <p class="m-0 mt-2"><a href={f.link.href} class="tap font-semibold">{f.link.text}</a></p>}
          </div>
        </details>
      ))}
    </div>
    <p class="mt-8"><a href={telHref(d.phones.main)} class="btn btn-primary tabular">Call {d.phones.main}</a></p>
  </section>
</Base>
