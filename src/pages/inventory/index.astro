---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/astro/Breadcrumbs.astro';
import InventoryListing from '../../components/astro/InventoryListing.astro';
import { publishedUnits, lastUpdated, TYPE_GROUPS, groupOf, cardData } from '../../lib/inventory';
import { breadcrumbJsonLd } from '../../lib/seo';

const units = await publishedUnits();
const onLot = units.filter((u) => u.status !== 'sold').length;
const present = TYPE_GROUPS.filter((g) => units.some((u) => groupOf(u).slug === g.slug)).map((g) => g.label.toLowerCase());
const updated = lastUpdated(units);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Inventory', path: '/inventory' }];
const listFmt = new Intl.ListFormat('en-CA', { type: 'conjunction' });
const lcp = units[0] ? (await cardData(units[0])).image : undefined;
const preloadImage = lcp && { src: lcp.src, srcset: lcp.srcset, sizes: '(min-width: 1280px) 400px, (min-width: 640px) 46vw, calc(100vw - 2rem)' };
---
<Base preloadImage={preloadImage} title="Used trailers and park models for sale" current="/inventory" jsonLd={[breadcrumbJsonLd(crumbs)]}
  description={`${onLot} used ${listFmt.format(present)} for sale at RV Farm, 1841 Hwy 7, Concord. Every price includes the PDI package and admin fee.`}>
  <Breadcrumbs items={crumbs} />
  <div class="wrap pb-16 pt-4">
    <h1 class="m-0 text-[2.25rem] lg:text-[3.25rem]">{onLot} used units on the lot</h1>
    <p class="mt-3 max-w-[44rem] text-lead">
      Every unit we have is on this page, with every photo we have. The price you see includes the PDI package and admin fee; only HST and the government plate fee are added.
    </p>
    {updated && (
      <p class="mt-2 text-bark-60">
        List updated <time datetime={updated}>{new Date(updated + 'T12:00:00').toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
      </p>
    )}
    <div class="mt-8">
      <InventoryListing units={units} allUnits={units} />
    </div>
  </div>
</Base>
