---
// Human-readable site map, generated from the real pages and units.
import Base from '../layouts/Base.astro';
import PageIntro from '../components/astro/PageIntro.astro';
import { publishedUnits, unitTitle, unitPath, TYPE_GROUPS, groupOf } from '../lib/inventory';
import { footerNav, legalNav, routeExists } from '../lib/site';

const units = await publishedUnits();
const groups = TYPE_GROUPS.filter((g) => units.some((u) => groupOf(u).slug === g.slug));
const pages = [
  { label: 'Home', href: '/' },
  ...footerNav.flatMap((c) => c.items).filter((i) => !i.external && !i.href.includes('#')),
  ...legalNav,
].filter((p, i, all) => routeExists(p.href) && all.findIndex((q) => q.href === p.href) === i);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Site map', path: '/sitemap' }];
---
<Base title="Site map" description="Every page and every unit on the RV Farm website.">
  <PageIntro crumbs={crumbs} title="Site map" />
  <div class="wrap grid gap-10 py-10 md:grid-cols-3">
    <section aria-labelledby="sm-pages">
      <h2 id="sm-pages" class="m-0 text-[1.5rem]">Pages</h2>
      <ul class="mt-3 list-none p-0">{pages.map((p) => <li><a href={p.href} class="tap">{p.label}</a></li>)}</ul>
    </section>
    <section aria-labelledby="sm-types">
      <h2 id="sm-types" class="m-0 text-[1.5rem]">Unit types</h2>
      <ul class="mt-3 list-none p-0">
        <li><a href="/inventory" class="tap">All units</a></li>
        {groups.map((g) => <li><a href={`/inventory/type/${g.slug}`} class="tap">{g.label}</a></li>)}
      </ul>
    </section>
    <section aria-labelledby="sm-units">
      <h2 id="sm-units" class="m-0 text-[1.5rem]">Units</h2>
      <ul class="mt-3 list-none p-0">{units.map((u) => <li><a href={unitPath(u)} class="tap">{unitTitle(u)}</a></li>)}</ul>
    </section>
  </div>
</Base>
