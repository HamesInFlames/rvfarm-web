---
// Interim one-page site (plan §3b, O10): replaces the Turnkey site while the full build happens.
// Name, logo, phone, address, hours, VOW link, "call about inventory". No inventory, no forms.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HoursTable from '../components/astro/HoursTable.astro';
import logo from '../assets/brand/rv-farm-logo-v2.png';
import dealership from '../data/dealership.json';
import { telHref } from '../lib/format';

const d = dealership;
---
<Base title={d.brandName} variant="interim"
  description="RV Farm sells used travel trailers, park models and mobile homes at 1841 Hwy 7 in Concord, Ontario. Call 905-605-7056 about what's on the lot today.">
  <section class="wrap grid items-center gap-10 py-10 md:py-16 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="eyebrow text-red m-0">Buy · Sell · Trade · Consign</p>
      <span class="rule-orange mt-3 mb-5" aria-hidden="true"></span>
      <h1 class="m-0 text-[2.25rem] lg:text-[3.25rem]">Used trailers, park models and mobile homes on Hwy 7 in Concord</h1>
      <p class="mt-5 max-w-[34rem] text-lead">
        Our new website is on its way. Until it's ready, call us about what's on the lot today.
        We'll tell you what we have, what it costs and when you can see it.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={telHref(d.phones.main)} class="btn btn-primary text-xl px-6 min-h-14 tabular">Call {d.phones.main}</a>
        <a href={d.address.mapsUrl} class="btn btn-secondary text-lg min-h-14" target="_blank" rel="noopener">
          Get directions<span class="sr-only"> (opens Google Maps in a new tab)</span>
        </a>
      </div>
    </div>
    <div class="lg:col-span-5">
      <div class="mx-auto max-w-[26rem] rounded border border-rule bg-white p-4">
        <Image src={logo} alt={`${d.brandName} logo: a travel trailer on a country road under the sun. ${d.tagline}`}
          width={400} height={400} densities={[1, 2]} loading="eager" fetchpriority="high" class="h-auto w-full" />
      </div>
    </div>
  </section>

  <section aria-labelledby="visit" class="border-y border-rule bg-paper">
    <div class="wrap grid gap-10 py-12 md:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="visit" class="m-0 text-[1.75rem] lg:text-[2.25rem]">Come see the lot</h2>
        <address class="mt-4 not-italic text-lead">
          {d.address.street}<br />{d.address.city}, {d.address.region} {d.address.postal}
        </address>
        <p class="mt-4">
          <a href={d.address.mapsUrl} target="_blank" rel="noopener" class="tap font-semibold">
            Open in Google Maps<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
      </div>
      <div class="lg:col-span-4">
        <HoursTable caption="Hours" />
        <p class="mt-3 text-bark-60">Units come and go. Call ahead and we'll have the one you want ready to look at.</p>
      </div>
      <div class="lg:col-span-3">
        <h2 class="m-0 text-[1.5rem]">Service and parts</h2>
        <p class="mt-3">{d.sibling.name} fixes RVs, trailers and more at the same address.</p>
        <p class="mt-2">
          <a href={telHref(d.sibling.phone)} class="tap font-semibold tabular">{d.sibling.phone}</a>
        </p>
        <p class="mt-2">
          <a href={d.sibling.url} target="_blank" rel="noopener" class="tap">vacationsonwheels.ca<span class="sr-only"> (opens in a new tab)</span></a>
        </p>
      </div>
    </div>
  </section>
</Base>
